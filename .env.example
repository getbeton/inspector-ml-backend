GOOGLE_API_KEY=
# LiteLLM's gemini/ provider reads GEMINI_API_KEY; if unset, the model factory
# mirrors GOOGLE_API_KEY into it automatically. Set explicitly to override.
GEMINI_API_KEY=

# Telemetry runs both backends concurrently; each turns on only when its own
# credentials are present. Set neither, either, or both.
AGENTOPS_API_KEY=
# Langfuse (optional). When PUBLIC + SECRET are set, ADK runs are traced via
# OpenInference's GoogleADKInstrumentor. LANGFUSE_HOST is the canonical host var.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Models are now LiteLLM strings: "<provider>/<model>" (e.g.
# anthropic/claude-opus-4-6, vertex_ai/gemini-3-flash). Bare names are treated
# as Gemini, so the values below keep working unchanged.
# Note: the old GEMINI_RETRY_* backoff/jitter knobs are no longer read after
# the LiteLLM switch — LiteLLM only exposes retry count via LLM_NUM_RETRIES.
# LLM_NUM_RETRIES=6

ATTIO_TOKEN=
ATTIO_LIMIT=200
ATTIO_MAX_PAGES=10
ATTIO_CACHE_TTL_SEC=21600

INSPECTOR_URL=
AGENT_SECRET=
VERCEL_PROTECTION=

UPSELL_AGENT_MODEL=gemini-3-flash-preview
DWH_ANALYST_MODEL=gemini-3-flash-preview
SIGNAL_AGENT_MODEL=gemini-3-flash-preview
SIGNAL_REVIEWER_MODEL=gemini-3-flash-preview

SIGNAL_AGENT_MAX_QUERIES=6
SIGNAL_AGENT_MAX_ROWS=200
SIGNAL_AGENT_MAX_ITERATIONS=8
SIGNAL_AGENT_TARGET_PROMOTED=3
SIGNAL_AGENT_MAX_FAILURES=5
SIGNAL_AGENT_MIN_ITERATIONS_BEFORE_EXIT=3

TELEGRAM_ANALYTICS_MODEL=gemini-3-flash-preview
TELEGRAM_ANALYTICS_REVIEWER_MODEL=gemini-3-flash-preview
TELEGRAM_DB_HOST=127.0.0.1
TELEGRAM_DB_PORT=5432
TELEGRAM_DB_NAME=
TELEGRAM_DB_USER=
TELEGRAM_DB_PASSWORD=
